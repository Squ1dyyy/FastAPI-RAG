POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_fastapi
POSTGRES_ECHO=false
FALLBACK_SQLITE_URL=sqlite+aiosqlite:///data/rag.db

REFERENCE_URL=https://fastapi.tiangolo.com/reference/
DATA_DIR=data
CACHED_ROUTERS_FILENAME=cached_routers.html
BROWSER_IMPERSONATE=safari15_5
GRABBER_CONCURRENCY=5

CHUNK_SIZE=1200
CHUNK_OVERLAP=200

DEVICE=cuda
USE_FP16=true

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIM=384
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=15
HYBRID_ALPHA=0.5
HYBRID_FUSION_METHOD=rrf
RRF_K=60

BM25_K1=1.5
BM25_B=0.75
USE_BM25S_BACKEND=true

RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANKER_BATCH_SIZE=32
USE_RERANKER=true
SMALL_TO_BIG=true

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60.0
RAG_SYSTEM_PROMPT="You are an expert FastAPI documentation assistant. You MUST answer the user's question strictly and exclusively using ONLY the provided FastAPI Reference Context chunks. Do NOT use external knowledge, do NOT invent API parameters, and do NOT make assumptions beyond the provided context. If the provided context does not contain enough information to answer the question, explicitly state that this information is not present in the retrieved documentation context. Always cite the exact section titles and URLs from the provided context."

SUPPORTED_LANGUAGES=en,de,es,fr,hi,ja,ko,pt,ru,tr,uk,zh,zh-hant
DEFAULT_LANGUAGE=ru

APP_HOST=127.0.0.1
APP_PORT=8000
CHAT_HISTORY_LIMIT=10
