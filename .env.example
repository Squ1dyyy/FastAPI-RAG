POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_fastapi
POSTGRES_ECHO=false

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
USE_RERANKER=true

HYBRID_ALPHA=0.5
HYBRID_FUSION_METHOD=rrf
RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=15

BM25_K1=1.5
BM25_B=0.75
USE_BM25S_BACKEND=true
